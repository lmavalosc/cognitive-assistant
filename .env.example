APP_ENV=local

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nucleo_cognitivo
POSTGRES_USER=nucleo
POSTGRES_PASSWORD=nucleo

REDIS_HOST=localhost
REDIS_PORT=6379

LOG_LEVEL=INFO

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Capa 3: Gobernanza y Autenticación
API_KEYS=dev-secret-key-1,dev-secret-key-2
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
GUARD_RISK_THRESHOLD=0.70


# Plano A: Inferencia LLM (LiteLLM)
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_API_KEY=
LLM_API_BASE=
LLM_MOCK_FALLBACK=true

# Capa 5: Memoria Persistente (mem0)
MEMORY_ENABLED=true
MEMORY_USER_ID=default_user
